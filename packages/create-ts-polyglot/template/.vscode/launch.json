{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: runs main.ts with the ts-polyglot hook under the debugger. Breakpoints in TypeScript
      // files work; the native functions run compiled, as they do with `npm start`.
      "name": "Debug main.ts",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/main.ts",
      "runtimeArgs": ["--import", "ts-polyglot/register"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
