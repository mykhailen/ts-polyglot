{
  // Type-checks the package's source and tests. What runs is the JavaScript that tsconfig.build.json
  // emits. The fixtures are projects of their own, type-checked by the end-to-end tests.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test"],
  "exclude": ["test/fixtures"]
}
